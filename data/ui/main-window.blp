using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  title: _("Remind Me");
  default-width: 640;
  default-height: 620;
  width-request: 360;
  height-request: 500;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView toolbar_view {
      [top]
      Adw.HeaderBar header_bar {
        title-widget: Adw.ViewSwitcher header_switcher {
          stack: view_stack;
          policy: wide;
        };

        [end]
        Gtk.MenuButton menu_button {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          primary: true;
        }
      }

      content: Adw.ViewStack view_stack {
        Adw.ViewStackPage {
          name: "reminders";
          title: _("Reminders");
          icon-name: "alarm-symbolic";

          child: Gtk.Box {
            orientation: vertical;

            Adw.Clamp {
              maximum-size: 600;
              tightening-threshold: 550;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-top: 16;
                margin-bottom: 16;
                margin-start: 12;
                margin-end: 12;

                Gtk.ListBox composer_group {
                  selection-mode: none;
                  styles ["boxed-list"]

                  Adw.EntryRow message_entry {
                    title: _("Message");
                    input-purpose: free_form;
                    max-length: 280;
                    show-apply-button: false;

                    [suffix]
                    Gtk.Button add_button {
                      valign: center;
                      icon-name: "list-add-symbolic";
                      tooltip-text: _("Add reminder");
                      styles ["suggested-action", "circular"]

                      accessibility {
                        label: _("Add reminder");
                      }
                    }
                  }

                  Adw.ActionRow when_row {
                    title: _("When");
                    subtitle: _("In 1 hour");
                    activatable: true;

                    [prefix]
                    Gtk.Image {
                      icon-name: "alarm-symbolic";
                      accessible-role: presentation;
                    }

                    [suffix]
                    Gtk.Image {
                      icon-name: "pan-down-symbolic";
                      accessible-role: presentation;
                    }
                  }
                }

                Gtk.Label composer_error {
                  visible: false;
                  halign: start;
                  xalign: 0;
                  wrap: true;
                  margin-start: 6;
                  margin-end: 6;
                  styles ["error"]
                }
              };
            }

            Gtk.Stack reminders_content {
              vexpand: true;
              transition-type: crossfade;

              Gtk.StackPage {
                name: "empty";

                child: Gtk.Box reminders_empty {
                  orientation: vertical;
                  spacing: 8;
                  valign: center;
                  halign: center;
                  margin-start: 24;
                  margin-end: 24;

                  Gtk.Image {
                    icon-name: "alarm-symbolic";
                    pixel-size: 48;
                    opacity: 0.55;
                    accessible-role: presentation;
                  }

                  Gtk.Label {
                    label: _("No reminders yet");
                    styles ["title-3"]
                  }

                  Gtk.Label {
                    label: _("Create one above when something comes up.");
                    wrap: true;
                    justify: center;
                    styles ["dim-label"]
                  }
                };
              }

              Gtk.StackPage {
                name: "list";

                child: Gtk.ScrolledWindow reminders_scroller {
                  hscrollbar-policy: never;

                  child: Adw.Clamp {
                    maximum-size: 600;
                    tightening-threshold: 550;

                    child: Gtk.Box active_groups {
                      orientation: vertical;
                      spacing: 16;
                      margin-top: 16;
                      margin-bottom: 16;
                      margin-start: 12;
                      margin-end: 12;
                    };
                  };
                };
              }
            }
          };
        }

        Adw.ViewStackPage {
          name: "history";
          title: _("History");
          icon-name: "document-open-recent-symbolic";

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 600;
              tightening-threshold: 550;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 16;
                margin-top: 16;
                margin-bottom: 16;
                margin-start: 12;
                margin-end: 12;

                Adw.Bin history_actions {
                  halign: end;

                  child: Gtk.Button clear_history_button {
                    label: _("Clear History");
                    styles ["destructive-action"]
                  };
                }

                Gtk.Box history_list {
                  orientation: vertical;
                  spacing: 16;
                }

                Adw.StatusPage history_empty {
                  icon-name: "document-open-recent-symbolic";
                  title: _("No History");
                  description: _("Completed reminders will appear here.");
                }
              };
            };
          };
        }
      };

      [bottom]
      Adw.ViewSwitcherBar bottom_switcher {
        stack: view_stack;
        reveal: false;
      }
    };
  };
}
