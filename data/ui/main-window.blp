using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  title: _("Cue");
  default-width: 560;
  default-height: 540;
  width-request: 360;
  height-request: 500;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView navigation_view {
      Adw.NavigationPage canvas_page {
        title: _("Cue");
        tag: "canvas";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Gtk.Button active_list_button {
              icon-name: "view-list-symbolic";
              tooltip-text: _("Active Reminders");

              styles [
                "flat",
              ]

              accessibility {
                label: _("Active Reminders");
              }
            }

            title-widget: Gtk.Label {
              label: _("Cue");

              styles [
                "title",
              ]
            };

            [end]
            Gtk.MenuButton menu_button {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              primary: true;
            }
          }

          content: Gtk.ScrolledWindow canvas_scroller {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 720;
              tightening-threshold: 480;

              child: Gtk.Box canvas_entries {
                orientation: vertical;
                spacing: 2;
                vexpand: true;
                margin-top: 18;
                margin-bottom: 24;
                margin-start: 20;
                margin-end: 20;
              };
            };
          };
        };
      }

      Adw.NavigationPage active_list_page {
        title: _("Active Reminders");
        tag: "active-list";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Gtk.Stack active_content {
            transition-type: crossfade;

            Gtk.StackPage {
              name: "empty";

              child: Adw.StatusPage active_empty {
                icon-name: "alarm-symbolic";
                title: _("No Active Reminders");
                description: _("Add an @schedule to a canvas note to create one.");
              };
            }

            Gtk.StackPage {
              name: "list";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;

                child: Adw.Clamp {
                  maximum-size: 560;
                  tightening-threshold: 500;

                  child: Gtk.Box active_groups {
                    orientation: vertical;
                    spacing: 14;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 12;
                    margin-end: 12;
                  };
                };
              };
            }
          };
        };
      }

      Adw.NavigationPage history_page {
        title: _("History");
        tag: "history";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            Gtk.Button clear_history_button {
              icon-name: "edit-clear-all-symbolic";
              tooltip-text: _("Clear History");

              styles [
                "flat",
              ]

              accessibility {
                label: _("Clear History");
              }
            }
          }

          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 560;
              tightening-threshold: 500;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 14;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;

                Gtk.Box history_list {
                  orientation: vertical;
                  spacing: 14;
                }

                Adw.StatusPage history_empty {
                  icon-name: "document-open-recent-symbolic";
                  title: _("No History");
                  description: _("Completed reminders will appear here.");
                }
              };
            };
          };
        };
      }
    };
  };
}
