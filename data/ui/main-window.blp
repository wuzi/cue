using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  title: _("Remind Me");
  default-width: 720;
  default-height: 700;
  width-request: 360;
  height-request: 500;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView toolbar_view {
      [top]
      Adw.HeaderBar header_bar {
        title-widget: Adw.ViewSwitcher header_switcher {
          stack: view_stack;
          policy: wide;
        };

        [end]
        Gtk.MenuButton menu_button {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          primary: true;
        }
      }

      content: Adw.ViewStack view_stack {
        Adw.ViewStackPage {
          name: "reminders";
          title: _("Reminders");
          icon-name: "alarm-symbolic";

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 720;
              tightening-threshold: 560;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 24;
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 18;
                margin-end: 18;

                Adw.PreferencesGroup composer_group {
                  title: _("Quick Reminder");
                  styles ["quick-composer"]

                  Adw.EntryRow message_entry {
                    title: _("Reminder message");
                    input-purpose: free_form;
                    max-length: 280;
                    show-apply-button: false;
                  }

                  Adw.ActionRow date_row {
                    title: _("Date");

                    [suffix]
                    Gtk.Button date_button {
                      valign: center;
                      label: _("Today");
                    }
                  }

                  Adw.ActionRow time_row {
                    title: _("Time");

                    [suffix]
                    Gtk.Button time_button {
                      valign: center;
                      label: _("Choose a time");
                    }
                  }

                  Gtk.Button add_button {
                    label: _("Add Reminder");
                    halign: end;
                    styles ["suggested-action", "pill"]
                  }

                  Gtk.Label composer_error {
                    visible: false;
                    halign: start;
                    xalign: 0;
                    wrap: true;
                    styles ["error"]
                  }
                }

                Gtk.Box active_groups {
                  orientation: vertical;
                  spacing: 20;
                }

                Adw.StatusPage reminders_empty {
                  icon-name: "alarm-symbolic";
                  title: _("No Reminders");
                  description: _("Add a reminder above and it will appear here.");
                }
              };
            };
          };
        }

        Adw.ViewStackPage {
          name: "history";
          title: _("History");
          icon-name: "document-open-recent-symbolic";

          child: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 720;
              tightening-threshold: 560;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 18;
                margin-top: 24;
                margin-bottom: 24;
                margin-start: 18;
                margin-end: 18;

                Adw.Bin history_actions {
                  halign: end;

                  child: Gtk.Button clear_history_button {
                    label: _("Clear History");
                    styles ["destructive-action"]
                  };
                }

                Gtk.Box history_list {
                  orientation: vertical;
                  spacing: 20;
                }

                Adw.StatusPage history_empty {
                  icon-name: "document-open-recent-symbolic";
                  title: _("No History");
                  description: _("Completed reminders will appear here.");
                }
              };
            };
          };
        }
      };

      [bottom]
      Adw.ViewSwitcherBar bottom_switcher {
        stack: view_stack;
        reveal: false;
      }
    };
  };
}
