using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow main_window {
  title: _("Remind Me");
  default-width: 560;
  default-height: 540;
  width-request: 360;
  height-request: 500;

  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView navigation_view {
      Adw.NavigationPage reminders_page {
        title: _("Remind Me");
        tag: "reminders";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            title-widget: Gtk.Label {
              label: _("Remind Me");
              styles ["title"]
            };

            [end]
            Gtk.MenuButton menu_button {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              primary: true;
            }
          }

          content: Gtk.Box {
            orientation: vertical;

            Adw.Clamp {
              maximum-size: 560;
              tightening-threshold: 500;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;

                Gtk.Box composer_card {
                  orientation: vertical;
                  styles ["card"]

                  Gtk.Box {
                    spacing: 6;
                    margin-top: 6;
                    margin-bottom: 6;
                    margin-start: 10;
                    margin-end: 6;

                    Gtk.Overlay {
                      hexpand: true;
                      child: Gtk.ScrolledWindow {
                        hscrollbar-policy: never;
                        vscrollbar-policy: automatic;
                        propagate-natural-height: true;
                        min-content-height: 42;
                        max-content-height: 90;

                        child: Gtk.TextView composer_input {
                          wrap-mode: word_char;
                          accepts-tab: false;
                          top-margin: 8;
                          bottom-margin: 8;
                          left-margin: 2;
                          right-margin: 2;
                          styles ["composer-input"]

                          accessibility {
                            label: _("Reminder sentence");
                            description: _("Write what to remember, followed by an optional schedule beginning with at sign");
                          }
                        };
                      };

                      [overlay]
                      Gtk.Label composer_placeholder {
                        label: _("What should I remind you about?");
                        halign: start;
                        valign: start;
                        margin-top: 8;
                        margin-start: 2;
                        can-target: false;
                        styles ["dim-label"]
                      }
                    }

                    Gtk.Button add_button {
                      valign: center;
                      icon-name: "list-add-symbolic";
                      tooltip-text: _("Add reminder");
                      styles ["suggested-action", "circular"]

                      accessibility {
                        label: _("Add reminder");
                      }
                    }
                  }

                  Gtk.Separator {}

                  Gtk.Button preview_button {
                    halign: fill;
                    styles ["flat", "schedule-preview"]
                    tooltip-text: _("Choose a custom date and time");

                    accessibility {
                      label: _("Reminder time");
                      description: _("In 1 hour");
                    }

                    child: Gtk.Box {
                      spacing: 6;

                      Gtk.Image {
                        icon-name: "alarm-symbolic";
                        accessible-role: presentation;
                      }

                      Gtk.Label schedule_preview {
                        label: _("In 1 hour");
                        xalign: 0;
                        hexpand: true;
                        ellipsize: end;
                        styles ["dim-label", "caption"]
                      }

                      Gtk.Image {
                        icon-name: "pan-down-symbolic";
                        accessible-role: presentation;
                      }
                    };
                  }
                }

                Gtk.Label composer_error {
                  visible: false;
                  accessible-role: alert;
                  halign: start;
                  xalign: 0;
                  wrap: true;
                  margin-start: 6;
                  margin-end: 6;
                  styles ["error", "caption"]
                }
              };
            }

            Gtk.Stack reminders_content {
              vexpand: true;
              transition-type: crossfade;

              Gtk.StackPage {
                name: "empty";

                child: Gtk.Box reminders_empty {
                  orientation: vertical;
                  spacing: 8;
                  valign: center;
                  halign: center;
                  margin-start: 24;
                  margin-end: 24;

                  Gtk.Label {
                    label: _("Try something like");
                    styles ["dim-label", "caption-heading"]
                  }

                  Gtk.Label composer_example_tomorrow {
                    selectable: true;
                    styles ["dim-label", "monospace"]
                  }

                  Gtk.Label composer_example_relative {
                    selectable: true;
                    styles ["dim-label", "monospace"]
                  }
                };
              }

              Gtk.StackPage {
                name: "list";

                child: Gtk.ScrolledWindow reminders_scroller {
                  hscrollbar-policy: never;

                  child: Adw.Clamp {
                    maximum-size: 560;
                    tightening-threshold: 500;

                    child: Gtk.Box active_groups {
                      orientation: vertical;
                      spacing: 14;
                      margin-top: 8;
                      margin-bottom: 12;
                      margin-start: 12;
                      margin-end: 12;
                    };
                  };
                };
              }
            }
          };
        };
      }

      Adw.NavigationPage history_page {
        title: _("History");
        tag: "history";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [end]
            Gtk.Button clear_history_button {
              icon-name: "edit-clear-all-symbolic";
              tooltip-text: _("Clear History");
              styles ["flat"]

              accessibility {
                label: _("Clear History");
              }
            }
          }

          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;

            child: Adw.Clamp {
              maximum-size: 560;
              tightening-threshold: 500;

              child: Gtk.Box {
                orientation: vertical;
                spacing: 14;
                margin-top: 12;
                margin-bottom: 12;
                margin-start: 12;
                margin-end: 12;

                Gtk.Box history_list {
                  orientation: vertical;
                  spacing: 14;
                }

                Adw.StatusPage history_empty {
                  icon-name: "document-open-recent-symbolic";
                  title: _("No History");
                  description: _("Completed reminders will appear here.");
                }
              };
            };
          };
        };
      }
    };
  };
}
